# =============================================================================
# EchoFS Configuration
# =============================================================================

# Authentication (REQUIRED - server will not start without this)
JWT_SECRET=generate-a-strong-random-secret-here

# Database
DATABASE_URL=postgres://user:password@localhost:5432/echofs?sslmode=disable

# Server Configuration
MASTER_PORT=8080
LOG_LEVEL=info

# Worker URLs (gRPC endpoints)
WORKER1_URL=localhost:10081
WORKER2_URL=localhost:10082
WORKER3_URL=localhost:10083

# Consistency Orchestrator
ORCHESTRATOR_URL=http://localhost:8082
REPLICATION_FACTOR=3

# CORS - Frontend URL (restrict cross-origin requests)
FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://frontend-echofs-projects.vercel.app

# AWS Configuration (optional - falls back to simulation mode)
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_REGION=us-east-1
S3_BUCKET_NAME=echofs-persistent-storage

# DynamoDB Tables (optional)
DYNAMODB_FILES_TABLE=echofs-files
DYNAMODB_CHUNKS_TABLE=echofs-chunks
DYNAMODB_SESSIONS_TABLE=echofs-sessions

# Controller State Persistence
CONTROLLER_STATE_PATH=./data/controller_state.json

# TLS (optional)
TLS_ENABLED=false
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem
